// Prisma Schema for Ganesh Heritage Resident Directory

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Member {
  id                String   @id // e.g. "A-101", "D-702"
  block             String   // "A", "B", "C", "D"
  flatNo            String   // "101", "1404", etc.
  floor             Int      // 1 to 14
  name              String   @default("")
  phone             String   @default("")
  status            String   @default("Vacant") // "Occupied" | "Vacant"
  residentType      String   @default("Owner")
  ownerName         String   @default("")
  ownerPhone        String   @default("")
  additionalDetails String   @default("")
  familyMembers     Json?    @default("[]")
  vehicles          Json?    @default("[]")
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([block])
  @@index([status])
}
