# ==========================================
# Society Configuration (.env)
# ==========================================
# Customize this file to deploy for any residential apartment or society.

# Database Connection (Neon / Postgres)
DB_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Society Branding
NEXT_PUBLIC_SOCIETY_NAME="Ganesh Heritage"
NEXT_PUBLIC_SOCIETY_SHORT_NAME="Ganesh Heritage"
NEXT_PUBLIC_SOCIETY_TAGLINE="Resident Directory"
NEXT_PUBLIC_SOCIETY_TYPE="Co-operative Housing Society"
NEXT_PUBLIC_SOCIETY_DESCRIPTION="Searchable resident directory for Ganesh Heritage Co-operative Housing Society"

# Building Structure & Blocks
# ------------------------------------------
# Option 1: Per-block custom structure with floors & flats per floor (Block:Floors:FlatsPerFloor)
# E.g. Block A with 10 floors and 6 flats/floor generates A-101 to A-1006.
# NEXT_PUBLIC_BLOCK_STRUCTURE="A:10:6,B:12:4,C:10:6,D:12:4"

# Option 2: Comma-separated blocks with global default floors and flats per floor
NEXT_PUBLIC_BLOCKS="A,B,C,D"
NEXT_PUBLIC_DEFAULT_BLOCK="A"
NEXT_PUBLIC_DEFAULT_FLOORS="14"
NEXT_PUBLIC_DEFAULT_FLATS_PER_FLOOR="4"

# Limits
NEXT_PUBLIC_MAX_VEHICLES="4"
NEXT_PUBLIC_MAX_FAMILY_MEMBERS="10"

# Edit Permissions
# Set to 'true' to allow editing existing flats from cards and forms.
# Set to 'false' so users can ONLY ADD data to vacant flats, and NEVER edit/overwrite already-occupied flats.
NEXT_PUBLIC_ALLOW_EDIT="true"

# Theme Accent Color (Hex)
NEXT_PUBLIC_THEME_COLOR="#dc2626"
